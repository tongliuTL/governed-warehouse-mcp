# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Read by `gwm-eval live` and `gwm-eval calibrate --live`; variables already set in the shell
# take precedence over this file.

# --- Model provider: MiniMax, through its Anthropic-compatible API ---------------------------
# The harness uses the Anthropic SDK, which reads these two variables.
# Key: your M Plan API key from https://platform.minimax.io/console/plan (M Plan keys and
# pay-as-you-go keys are not interchangeable).
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_API_KEY=
# Models served on that endpoint: MiniMax-M3.1-Flash (in M Plan) or MiniMax-M3.
GWM_MODEL=MiniMax-M3.1-Flash
GWM_JUDGE_MODEL=MiniMax-M3.1-Flash

# To use the Claude API instead: remove ANTHROPIC_BASE_URL, set ANTHROPIC_API_KEY to a
# Claude key, and remove GWM_MODEL / GWM_JUDGE_MODEL (defaults: claude-opus-5-5).

# --- Langfuse tracing (project Settings > API Keys); leave the keys empty to skip tracing -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com  or your self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=eval
